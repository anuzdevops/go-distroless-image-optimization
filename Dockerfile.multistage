
# ==========================================
# Stage 1: Build the Go application
# ==========================================
FROM golang:1.27.4 AS builder

WORKDIR /app

COPY go.mod ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o containerscope \
    ./cmd/server

# ==========================================
# Stage 2: Minimal runtime image
# ==========================================
FROM debian:13-slim

WORKDIR /app

COPY --from=builder /app/containerscope .

EXPOSE 8080

ENV PORT=8080

CMD ["./containerscope"]
